{
  "name": "indexia-group",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:frontend": "vite",
    "dev:server": "node --env-file-if-exists=server/.env server/index.js",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "dev": "concurrently -n \"VITE,SERVER\" -c \"yellow,red\" \"npm run dev:frontend\" \"npm run dev:server\""
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "cobe": "^2.0.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "i18next": "^26.3.6",
    "lucide-react": "^1.28.0",
    "mongoose": "^9.9.3",
    "multer": "^2.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.4",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1",
    "vite-plugin-compression": "^0.5.1"
  }
}
