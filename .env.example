# ── Server (server/.env) ──────────────────────────────────────────
# Port for the Express backend (also used by the Vite dev proxy)
PORT=3001

# MongoDB connection string. Required for the contact form, job
# applications, job openings, and the news feed.
MONGODB_URI=

# Admin dashboard auth token. Required for /admin and all /api/admin
# endpoints. Requests must send it via the `x-admin-token` header.
ADMIN_TOKEN=

# NewsData.io API key. Required for the scheduled news fetcher and the
# manual "refresh news" action in the admin dashboard.
NEWSDATA_API_KEY=

# Comma-separated allowlist of origins that may call the API from a browser
# (CORS). Only matters when the frontend and backend are on different origins;
# same-origin requests are always allowed. Defaults to the production site and
# http://localhost:5173 — set this when deploying the frontend separately
# (e.g. CORS_ORIGINS=https://my-frontend.example.com).
CORS_ORIGINS=

# ── Frontend (.env.local / .env.production) ──────────────────────
# Base URL for API calls when the frontend and backend are hosted on
# different origins (e.g. VITE_API_URL=https://api.example.com).
# Leave empty when they share the same origin so relative /api/... paths work.
VITE_API_URL=