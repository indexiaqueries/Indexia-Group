[TEMPLATE]
PORT=3001

# MongoDB connection string (required)
MONGODB_URI=

# Secret used to sign admin session cookies (required for /admin).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Optional extra protection for the ONE-TIME admin setup endpoint
# (POST /api/admin/register). When set, the request must also include
# the header `x-admin-setup-token: <this value>`. Leave empty only while
# bootstrapping locally.
ADMIN_SETUP_TOKEN=

# NewsData.io API key (optional, enables news fetcher)
NEWSDATA_API_KEY=

# Additional CORS origins, comma-separated (optional). The production
# frontend and local Vite addresses are allowed by default.
CORS_ORIGINS=

# Session cookie SameSite policy. Production defaults to "none" (required for
# the split deployment: frontend on indexiagroup.com, API on Render). Set to
# "lax" for same-origin deployments or local testing.
COOKIE_SAMESITE=
