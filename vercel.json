{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "framework": null,
  "redirects": [
    { "source": "/finance", "destination": "https://indexiafinance.com/", "permanent": true },
    { "source": "/finserve", "destination": "https://indexiafinance.com/", "permanent": true },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "indexiagroup.com" }],
      "destination": "https://www.indexiagroup.com/:path*",
      "permanent": true
    }
  ],

  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],

  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Link", "value": "</fonts/fraunces-700.woff2>; rel=preload; as=font; type=font/woff2; crossorigin, </fonts/fraunces-600.woff2>; rel=preload; as=font; type=font/woff2; crossorigin, </fonts/fraunces-400.woff2>; rel=preload; as=font; type=font/woff2; crossorigin" }
      ]
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 30
    }
  }
}
